# SQLite 파일 경로. 컨테이너에서는 /app/db 볼륨에 저장된다.
DB_PATH=/app/db/farmflow.db

# 스마트팜 자동제어용 MQTT 브로커 (SPEC 7.2). 비워두면 자동제어는 비활성.
# docker compose 는 비어 있을 때 mqtt://mosquitto:1883 (compose 의 브로커) 을
# 자동으로 넣는다. 외부 브로커를 쓰려면 여기에 적는다.
# 예: mqtt://mosquitto:1883 · mqtt://user:pass@broker.example:1883
MQTT_BROKER_URL=

# 빈 데이터베이스를 시작 시 시드 데이터로 채운다.
SEED_ON_START=true

# true 이면 LLM 호출 대신 결정론적 목 응답을 사용한다 (테스트/데모용).
LLM_MOCK=false
